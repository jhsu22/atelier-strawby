---
import '../styles/global.css';
import { brand } from '../config/brand.ts';
interface Props { pageTitle?: string }
const { pageTitle = 'Collection' } = Astro.props;
// The owner's install opens the editing shelf; everyone else's opens the shared one.
const manifest = Astro.locals.canEdit ? '/manifest-edit.webmanifest' : '/manifest.webmanifest';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Browse your manga and CD collection." />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href={manifest} />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-title" content="Strawby" />
    <title>{brand.project} — {pageTitle}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('strawby-theme');
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved
          : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to the collection</a>
    <slot />
    {import.meta.env.PROD && <script is:inline>
      // Offline shelf (public/sw.js). Built pages only, so development never serves stale assets.
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').then(() => navigator.serviceWorker.ready).then((registration) => {
            const urls = [location.href, ...performance.getEntriesByType('resource').map((entry) => entry.name)];
            registration.active?.postMessage({ type: 'strawby:store', urls });
          }).catch(() => {});
        });
      }
    </script>}
  </body>
</html>
