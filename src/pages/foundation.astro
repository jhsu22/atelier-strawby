---
import AppLayout from '../layouts/AppLayout.astro';
import { CollectionCounts } from '../components/stats/CollectionCounts.tsx';
import { readCollectionSummary } from '../server/repositories/collection.ts';
import type { CollectionSummary } from '../domain/types.ts';
let summary: CollectionSummary | undefined;
try { summary = await readCollectionSummary(Astro.locals.runtime.env.DB); }
catch { Astro.response.status = 503; }
---
<AppLayout pageTitle="Collection record">
  <main id="main" class="foundation-page">
  <a href="/" class="text-button">← Back to the shelf</a>
  <h1 class="font-serif text-4xl">Collection record</h1>
  {summary ? <>
    <CollectionCounts summary={summary} />
    {summary.physicalCopies === 0 && <p>No collection has been imported yet. Run the local migration and seed commands in the README.</p>}
    <table><caption class="mb-2 text-left font-semibold">Manga copies by language</caption><thead><tr><th scope="col">Language</th><th scope="col">Copies</th></tr></thead>
      <tbody>{summary.languages.map(row => <tr><th scope="row">{row.label}</th><td>{row.count}</td></tr>)}</tbody>
    </table>
    <p class="my-6">{summary.datedCopies} dated copies · {summary.undatedCopies} unknown dates · {summary.recordsWithNotes} acquisition notes</p>
    <table><caption class="mb-2 text-left font-semibold">Publisher distribution</caption><thead><tr><th scope="col">Publisher</th><th scope="col">Copies</th></tr></thead>
      <tbody>{summary.publishers.map(row => <tr><th scope="row">{row.label}</th><td>{row.count}</td></tr>)}</tbody>
    </table>
    <p class="mt-6">{summary.personalCds} CDs</p>
  </> : <p class="mt-6" role="alert">The collection database is unavailable. Apply local migrations and check the D1 binding using the README setup commands.</p>}
  </main>
</AppLayout>
