---
import AppLayout from '../layouts/AppLayout.astro';
import { LibraryBoundary } from '../components/ui/LibraryBoundary.tsx';
import { readLibrary } from '../server/repositories/library.ts';
import { parseBrowseState } from '../domain/library.ts';
import type { LibraryData } from '../domain/library.ts';
let data: LibraryData | undefined;
// Private notes reach only the owner's editing view, never the public shelf.
try { data = await readLibrary(Astro.locals.runtime.env.DB, { owner: Astro.locals.canEdit }); }
catch { Astro.response.status = 503; }
---
<AppLayout>
  {data ? <LibraryBoundary initialData={data} initialState={parseBrowseState(Astro.url.searchParams)} canEdit={Astro.locals.canEdit} renderedAt={Date.now()} client:load />
    : <main id="main" class="unavailable-page">
      <h1>Collection unavailable</h1><p role="alert">Check the database connection and setup.</p>
      <a href="/" class="button button-primary">Try the shelf again</a><a href="/foundation" class="text-button">Open the collection record</a>
    </main>}
  <noscript><p class="noscript-notice">Enable JavaScript to search and filter, or <a href="/foundation">view the collection record</a>.</p></noscript>
</AppLayout>
